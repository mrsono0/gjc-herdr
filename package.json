	"version": "0.1.0",
	"description": "Display-only Herdr model and session metadata for GJC",
	"type": "module",
	"license": "UNLICENSED",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mrsono0/gjc-herdr.git"
	},
	"homepage": "https://github.com/mrsono0/gjc-herdr",
	"bugs": {
